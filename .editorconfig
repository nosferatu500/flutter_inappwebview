root = true

# Repo-wide baseline. Deliberately minimal: `dart format` owns Dart layout and
# Xcode owns Swift, so nothing here competes with them.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------------------
# Kotlin — the Android plugin module (19,429 lines, no formatter until now).
#
# Enforced with ktlint 1.8: `npm run format:kotlin` / `format:kotlin:check`.
#
# These values are DESCRIPTIVE, measured against the existing sources rather
# than chosen: 2-space indent dominates (3,095 / 5,135 / 3,268 lines at 2 / 4 /
# 6 columns) and the 99th-percentile line is 99 characters. Adopting them keeps
# the reformat small instead of rewriting a module nobody has runtime coverage
# for.
# ---------------------------------------------------------------------------
[*.{kt,kts}]
indent_style = space
indent_size = 2
max_line_length = 100
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# `intellij_idea`, not ktlint's default `ktlint_official`: the latter mandates
# 4-space indent and a wrapping style this codebase does not use, so it would
# rewrite essentially every file for no behavioural gain.
ktlint_code_style = intellij_idea

# --- Rules disabled because applying them would BREAK THE PLUGIN -------------
#
# ktlint's naming rules do not know which identifiers are load-bearing. Each of
# these was measured, not guessed; see DEPRECATION_CLEANUP.md §39.
#
# enum-entry-name-case (77 findings): `WebViewChannelDelegateMethods` entries
#   ARE the channel method strings -- `WebViewChannelDelegate` dispatches with
#   `WebViewChannelDelegateMethods.valueOf(call.method)`. Renaming `getUrl` to
#   `GET_URL` makes that `valueOf` throw for every WebView call at runtime,
#   while compiling clean and passing all 313 unit tests.
# package-name (70): the module's packages are `content_blocker`,
#   `in_app_webview`, `chrome_custom_tabs` ... Renaming them re-does the
#   namespace §10 just settled, for nothing.
# function-naming / property-naming / backing-property-naming (50): these want
#   SCREAMING_CASE constants and JS-mirroring functions renamed. That is the
#   same ~1,858 public-API rename this fork has explicitly parked.
ktlint_standard_enum-entry-name-case = disabled
ktlint_standard_package-name = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled

# --- Rules disabled as pure churn -------------------------------------------
#
# Together these were 1,400+ findings, none of which is a defect: they impose a
# wrapping and trailing-comma house style the module does not use. Re-enable any
# of them deliberately, with a reformat commit of its own -- not as a rider.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_function-expression-body = disabled

# Files that build JavaScript payloads out of concatenated string literals. A
# wrapped JS string still compiles and still passes every test in this repo; it
# fails on a device. So the line limit is off here, not negotiated.
#
# NOTE: this is deliberately NOT just `plugin_scripts_js/` -- three files outside
# that directory build JS the same way, and the shorter glob silently missed 18
# findings' worth of them. Check for `"(function(` before adding a file here.
[flutter_inappwebview_android/android/src/main/kotlin/**/{plugin_scripts_js/*.kt,types/UserContentController.kt,types/WebMessagePort.kt,content_blocker/ContentBlockerHandler.kt}]
max_line_length = off

# Generated by Pigeon. Regenerate; never hand-format.
[**/pigeons/*.g.kt]
ktlint = disabled

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
