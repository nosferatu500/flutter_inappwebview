<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="InAppWebViewTheme" parent="Theme.AppCompat">

    </style>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- InAppBrowserActivity lays out edge-to-edge and pads its toolbar by the status bar
             inset, so the toolbar paints its own background behind the status bar. Declared here
             instead of via the deprecated Window.setStatusBarColor(); ignored on API 35+, where
             the platform enforces a transparent status bar anyway. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Dark status bar icons over the light toolbar, light ones over the dark one. The
             Material 3 theme doesn't set this itself: without it the icons stayed white on the
             light toolbar (measured on Android 17). DayNight resolves isLightTheme per mode. -->
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="ThemeTransparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
